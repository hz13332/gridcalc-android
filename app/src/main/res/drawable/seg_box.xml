<?xml version="1.0" encoding="utf-8"?>
<!-- t333 #92 稿 L256: Seg 是**单容器** 1px 描边 + 8dp 圆角, 配 clipToOutline
     (Android 的 overflow:hidden)。段内各自**没有**描边, 三段相接零缝。
     稿的 line 变量 ⟷ App 的 colorBorder。
     ⚠ 注释里不能出现两个连字符, 稿的 CSS 变量名正好有两个 ⟹ 上面写成「line 变量」。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1dp" android:color="?attr/colorBorder" />
    <corners android:radius="8dp" />
</shape>
