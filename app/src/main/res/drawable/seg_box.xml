<?xml version="1.0" encoding="utf-8"?>
<!-- 分段器**轨道**（Seg 单容器；与 seg_frame 是同一角色的两个名字，两处都引）。
     2026-10-16 t49 · 方向 B §2.4-3.6 分段器 + §2.3 圆角：
       轨道 = **bg-surface-2 底 + r999 药丸**（改前：透明底 + 1px 描边 + 8dp 圆角）。
       ⚠ 描边**去掉**了：方向 B 的轨道靠 surface-2 与画布的面层差收口（theme.css §6.4
         `border: 0`），不再画 1px 线。段内各自零描边、零缝。
       圆角 999 ⟹ Android 自动夹到半高 = 胶囊（与稿 borderRadius:999 同口径）。
       clipToOutline（Android 的 overflow:hidden）仍由宿主 LinearLayout 负责，
       见 page_settings.xml —— 但方向 B 的段自己就是药丸，裁剪不再是圆角的唯一来源。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurface2" />
    <corners android:radius="999dp" />
</shape>
