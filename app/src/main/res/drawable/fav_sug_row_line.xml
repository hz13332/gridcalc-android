<?xml version="1.0" encoding="utf-8"?>
<!--
  候选行的行间 1dp 发丝(移植对照表 §5.3), 与 drawable/fav_row_line.xml 同构(底边 + colorBorder)。
  ⚠ 与自选行的区别: 候选行是**容器内的一组**, 收口靠容器自己的 1dp 描边(fav_sug_bg),
    所以**末行下面不画线** —— 由 FavPanel.sugRow 给末行挂 null 背景来实现, 本文件只负责非末行。
  ⚠ 只读既有 token colorBorder, 不新增色值。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorBorder" />
        </shape>
    </item>
</layer-list>
