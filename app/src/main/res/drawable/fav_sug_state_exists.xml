<?xml version="1.0" encoding="utf-8"?>
<!--
  候选行状态列「已在自选」chip 的背景(移植对照表 §5.3):
  colorInput 底 + 1dp colorBorder 描边 + r8。下沉 = 失能, 与「已加入自选」的紫描边形成对比。
  **非可点**(不挂 selector, 不设 clickListener) —— 它替代的是现状那句静默 no-op。
  ⚠ 对比度最紧的一条: colorFaint on colorInput = 4.70(浅) / 4.87(深), 均 ≥4.5,
    所以文字色只能取 colorFaint, 别再调浅(对照表 §1.2)。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorInput" />
    <stroke android:width="1dp" android:color="?attr/colorBorder" />
    <corners android:radius="8dp" />
</shape>
