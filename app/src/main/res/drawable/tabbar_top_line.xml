<?xml version="1.0" encoding="utf-8"?>
<!-- 底部导航 tab 容器：底色 + 压在【上】边的 1px 分隔线（layer-list）。
     2026-10-16 t49 · 方向 B §2.4-3.1 脚手架：底栏 = **bg-surface + 1px -border 顶边**。
       底层由 colorCanvas 换成 **colorCard**（= bg-surface）—— 底栏是抬起的卡面，
       不是画布（v1 与画布同色 ⟹ 底栏与内容区读不出分界）。
       顶层 1px 线仍 colorBorder（= -border）。
     ⚠ tabbar 在 activity_main.xml（本轮 outOfScope），盒子由 MktPanel 的 init 挂上去；
       底栏高 61px 与「选中 = 主色浅底药丸」属 M6，也在下一轮（layout + Kotlin）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorCard" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorBorder" />
        </shape>
    </item>
</layer-list>
