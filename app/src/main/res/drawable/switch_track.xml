<?xml version="1.0" encoding="utf-8"?>
<!-- 开关**轨道**（只管轨道；thumb 两态仍在 MainActivity.t211PaintSwitch 的 thumbTintList —— 同一件事只留一个主人）。
     2026-10-16 t49 · 方向 B §2.4-3.7 开关 + §2.3 圆角：
       几何 44×26 / 滑块 20 内缩 3 / 开态位移 16 ⟹ **几何在 layout 侧**（M10，下一轮），
       本 drawable 只落**色与描边**：
         开态   底 colorAccentFill（= -accent-fill，白字/白描边压它 4.80:1 深色）
         开+按压 底 colorAccentPressed（= -accent-pressed，theme.css §6.5 末行）
         关态   底 colorTrackOff（= -track-off）
       描边 1dp：**关态 = colorControlOutline**（浅 3.74:1 / 深 3.57:1 压自身轨道底，本机复算）、
         **开态 = colorOnPrimary**（白压主色实底 5.87:1 / 4.80:1，本机复算）——
         逐字照 theme.css §6.5 的四态实算。
       ⚠ **两态都绝不能把描边写成 transparent**：那样对比度闸读到的是「描边 = 自身底色」= 1.00:1 必判低对比。
     圆角 999dp：Android 自动夹到半高 = 胶囊，与 borderRadius:999 同口径。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 开态 + 按压（theme.css §6.5 `.gc-sw-on:active` ⟹ accent-pressed） -->
    <item android:state_checked="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorAccentPressed" />
            <stroke android:width="1dp" android:color="?attr/colorOnPrimary" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- 开态：主色实底 + 白描边（几何不变） -->
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorAccentFill" />
            <stroke android:width="1dp" android:color="?attr/colorOnPrimary" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <!-- 关态：中性轨 + control-outline 描边（v1 这里用的是 colorBorder，压画布只有 1.35:1） -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorTrackOff" />
            <stroke android:width="1dp" android:color="?attr/colorControlOutline" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
