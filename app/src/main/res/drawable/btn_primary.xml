<?xml version="1.0" encoding="utf-8"?>
<!-- 主按钮（两态）。
     2026-10-16 t49 · 方向 B §2.4-3.5 主档 + §2.1 主色拆角色：
       常态 = colorAccentFill（当实底的蓝）、按压 = colorAccentPressed；圆角 **8 → 10dp**。
       ⚠ 改前的常态是 colorPrimary、按压是 colorPrimaryPressed（v1 的「主色 60% 叠画布」合成口径）——
         两个口径都退役：文字/描边角色走 colorAccentText，实底角色走 colorAccentFill。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorAccentPressed" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorAccentFill" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
