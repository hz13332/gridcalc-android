<?xml version="1.0" encoding="utf-8"?>
<!-- B-29 稿 L592 到 L612 NumField 两态。
     非编辑态 = 稿 L606 到 L610 的 span: 完全裸, 靠 gravity=right + fs_title 墨色呈现。
     编辑态   = 稿 L598 到 L605 的 input: 底 var(panel) + 1px 边框 var(ac) + 圆角 6。
     圆角取 6dp 而非 input_bg 的 8dp —— 稿 L604 写的是 6。
     ⚠ 行号区间一律写成「L606 到 L610」, 不能写 L606-610:
       两个连字符在 XML 注释里是非法的, aapt2 会直接判资源编译失败(t278 踩过)。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorInput" />
            <stroke android:width="1dp" android:color="?attr/colorPrimary" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
