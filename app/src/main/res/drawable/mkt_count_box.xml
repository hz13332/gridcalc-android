<?xml version="1.0" encoding="utf-8"?>
<!--
  行情页「数量」输入框的描边盒。

  稿 v2.html:2065-2071 逐字（该 input 的 style）：
    border:'1px solid <line>' / borderRadius:6 / padding:'2px 6px'
    textAlign:'right' / fontSize:T.title / background:'transparent'

  ⟹ 1px 描边 + 圆角 6 + 透明底，文字右对齐、字号 16sp(T.title)。

  改前这个框 background=@null，是**裸数字、屏上连框都没有**，与稿不一致
  （稿那个 input 明确带描边）。radius 取 6 而非 8：这是稿自己的值，
  与搜索框那个 radius 8（mkt_search_box）**不是同一个盒**，别混用。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorBorder" />
    <corners android:radius="6dp" />
</shape>
