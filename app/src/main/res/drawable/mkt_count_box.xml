<?xml version="1.0" encoding="utf-8"?>
<!--
  行情页「数量」输入框的描边盒。

  稿 v2.html:2065-2071 逐字（该 input 的 style）：
    border:'1px solid <line>' / borderRadius:6 / padding:'2px 6px'
    textAlign:'right' / fontSize:T.title / background:'transparent'

  ⟹ 1px 描边 + 透明底，文字右对齐、字号 16sp(T.title)。
  改前这个框 background=@null，是**裸数字、屏上连框都没有**，与稿不一致
  （稿那个 input 明确带描边）。

  ── 2026-10-16 t58（方向 B §2.3 + §5.1-③）────────────────────────────────
    圆角 **6dp → 10dp**（= r-input 档）。依据两条：
      · 方向 B §2.3「圆角只用 **12 / 10 / 999** 三档」（卡 / 输入 / 药丸）——
        稿的 6 不在任何一档；
      · 交接_方向B.md §5.1-③「App 输入类圆角 6/8 不一致 ⟹ **一次收齐到 10dp**」。
    ⟹ 与 input_bg / calc_input_bg / save_btn_bg / btn_ghost 同档（全部 10dp）。
    ⚠ 本件**不是**共享件：它是行情屏专属的「数量」框，所以 t49（共享 drawable 换档）
      没扫到它 —— 属任务分解的归属缺口，t58 补上。
    ⚠ 活引用 5 处（`page_mkt.xml` L366 数量框**默认可见** + L417 + L590/606/621 拆股编辑区），
      本件换档后 5 处同时生效。
    ⚠ 旧注释里那句「radius 取 6 而非 8：这是稿自己的值」**已退役** ——
      本轮口径以方向 B 的三档圆角为准，不再逐件对齐 v1 稿的零散值。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorBorder" />
    <corners android:radius="10dp" />
</shape>
