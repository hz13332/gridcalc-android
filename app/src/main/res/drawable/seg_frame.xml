<?xml version="1.0" encoding="utf-8"?>
<!-- 稿 L256 Seg 容器: display:inline-flex; border:1px solid colorBorder;
     borderRadius:8; overflow:hidden。overflow:hidden 在 Android 这边靠宿主
     LinearLayout 的 clipToOutline 达成(见 page_settings.xml)。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1dp" android:color="?attr/colorBorder" />
    <corners android:radius="8dp" />
</shape>
