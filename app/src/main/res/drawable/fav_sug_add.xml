<?xml version="1.0" encoding="utf-8"?>
<!--
  候选行状态列「＋」的背景(移植对照表 §5.3): 1dp colorPrimary 描边 + r8 + 透明底;
  按下底转 colorBorder, 与 btn_ghost.xml 同款语义。
  ⚠ 与 btn_ghost 的唯一差别: 描边色是 colorPrimary(紫点睛)而不是 colorBorder。
    单开一个而不改 btn_ghost: 后者是全 App 其他 ghost 按钮共用的(对照表 §8-N9 既有 drawable 一律不改)。
  ⚠ 不是实心紫按钮: 底是透明的, 紫只做描边 + 文字(对照表 §4.2)。
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorBorder" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="?attr/colorPrimary" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
