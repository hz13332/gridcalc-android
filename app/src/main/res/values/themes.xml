<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 2026-10-21 迁移：token 值不再手写在本文件 ——
         色/值住在 values/tokens_generated.xml（由 theme.css 生成，**勿手改**）；
         本文件只留 App 自有 token（colorBlueBg）与非 token 项（字体 / 状态栏 / textColor*）。
         改了稿请改 theme.css 后重跑：python toolchain/tokens/gen_android.py（apply 模式） -->
    <!-- ⚠⚠ 2026-10-16 t49：色 token 整表换成 **方向 B「分层卡片」** 的 20 色
         （规格 design/四屏视觉改版/交接_方向B.md §2.1 色表 / §2.5 改名表 / §5.3-M1）。
         对照表写在 attrs.xml 下半段（不写就不可查）。三条要点：
           ① 面层从 3 级变 4 级：新增 colorSurface2 / colorSurface3（+ 派生的 colorSurfaceRaised）；
           ② **主色拆两个角色**：colorAccentText（当文字/描边，深色要够亮）与
              colorAccentFill（当实底，白字要够深）—— 这正是 v1 F-5 的根因；
           ③ **涨绿跌红只换值、不翻转**（colorTeal 仍是涨/买，colorRed 仍是跌/卖）。 -->
    <style name="Theme.GridCalc.Light" parent="Theme.GridCalc.Tokens.Light">
        <item name="colorBlueBg">#1F9B7DFF</item>
        <item name="android:windowBackground">?attr/colorCanvas</item>
        <item name="android:statusBarColor">?attr/colorCanvas</item>
        <item name="android:navigationBarColor">?attr/colorCanvas</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- 2026-10-02 全局字体族换成 Inter（设计稿 v2.html:9 的第一顺位）。
             改前本主题未声明 fontFamily → 全 App 走系统默认 Roboto。详见 res/font/inter.xml 注释。 -->
        <item name="android:fontFamily">@font/inter</item>
        <!-- ⚠⚠ 2026-10-07 **根因修复**（用户原话「我怎么看不到数值」）。
             两个主题的 parent 都是 `android:Theme.Material.NoActionBar` —— 那是**深色**主题，
             其 ?android:textColorPrimary 默认 = #B3FFFFFF（白 @70%）。
             于是任何在 Kotlin 里 `TextView(act)` 新建、又没显式 setTextColor 的视图，
             在浅色画布 #F9FAFD 上渲染成白字：实测字形像素 (253,254,254)，
             与 #B3FFFFFF 叠在 #F9FAFD 上的理论值逐位吻合 —— 肉眼等于隐形。
             自选屏「距支撑」数值就踩了这个：日志实测其 currentTextColor = #B3FFFFFF，
             而代码传入的 colorPrimary 明明是 #FF6749B6。
             【修在 owner 上】不逐格打补丁，把框架三档默认字色钉到本 App 的墨色 token，
             以后任何漏上色的新视图都默认是墨色，不会再隐形。 -->
        <item name="android:textColorPrimary">?attr/colorInk</item>
        <item name="android:textColorSecondary">?attr/colorSub</item>
        <item name="android:textColorTertiary">?attr/colorFaint</item>
        <item name="android:textColor">?attr/colorInk</item>
        <item name="android:textColorHint">?attr/colorFaint</item>
    </style>

    <!-- 深色 · 夜晚 -->
    <!-- ⚠⚠ 2026-10-16 t49：同浅色，整表换成方向 B 的 20 色（交接 §2.1 右列）。
         深色的层次**不走阴影**（§2.3：elev-* 在深色一律 none）而走 4 级色调阶梯：
         canvas #0E1116 → surface #161B22 → surface-2 #1E242D → surface-3 #272E38，每级更亮。 -->
    <style name="Theme.GridCalc.Dark" parent="Theme.GridCalc.Tokens.Dark">
        <item name="colorBlueBg">#269B7DFF</item>
        <item name="android:windowBackground">?attr/colorCanvas</item>
        <item name="android:statusBarColor">?attr/colorCanvas</item>
        <item name="android:navigationBarColor">?attr/colorCanvas</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- 同浅色主题：全局字体族 Inter。两套主题必须都写，
             android:fontFamily 不会从 Light 继承到 Dark。 -->
        <item name="android:fontFamily">@font/inter</item>
        <!-- ⚠⚠ 2026-10-07 同浅色：把框架默认字色钉到本 App 的墨色 token。
             深色主题下 colorInk=#E7E9EF、colorSub=#9CA0A8、colorFaint=#82868f，
             原先吃的是 Material-dark 默认 #B3FFFFFF 白 @70% —— 深色画布上勉强能看，
             但与本 App 的墨色体系不是一套，同样属于漏上色。两套主题一起收敛。 -->
        <item name="android:textColorPrimary">?attr/colorInk</item>
        <item name="android:textColorSecondary">?attr/colorSub</item>
        <item name="android:textColorTertiary">?attr/colorFaint</item>
        <item name="android:textColor">?attr/colorInk</item>
        <item name="android:textColorHint">?attr/colorFaint</item>
    </style>
</resources>
