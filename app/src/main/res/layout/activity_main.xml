<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorCanvas"
    android:orientation="vertical">

    <!-- 内容区 -->
    <FrameLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 底部 Tab -->
    <LinearLayout
        android:id="@+id/tabbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/colorCanvas"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">
        <LinearLayout
            android:id="@+id/tab_calc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/tab_calc_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/tab_calc" />
            <TextView
                android:id="@+id/tab_calc_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="计算"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab_setup"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/tab_setup_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/tab_gear" />
            <TextView
                android:id="@+id/tab_setup_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="设置"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab_mkt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/tab_mkt_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/tab_mkt" />
            <TextView
                android:id="@+id/tab_mkt_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="行情"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
