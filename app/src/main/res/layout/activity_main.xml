<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorCanvas"
    android:orientation="vertical">

    <!-- 顶栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="14dp"
        android:paddingRight="14dp">
        <TextView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/brand_bg"
            android:gravity="center"
            android:text="网"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="17sp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="网格交易收益计算器"
                android:textColor="?attr/colorInk"
                android:textSize="17sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GRID CALC · 等比网格"
                android:textColor="?attr/colorFaint"
                android:textSize="11sp"
                android:letterSpacing="0.12" />
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorBorder" />

    <!-- 内容区 -->
    <FrameLayout
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 底部 Tab -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="?attr/colorCanvas"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">
        <LinearLayout
            android:id="@+id/tab_calc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/tab_calc_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/tab_calc" />
            <TextView
                android:id="@+id/tab_calc_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="计算"
                android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tab_setup"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/tab_setup_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/tab_gear" />
            <TextView
                android:id="@+id/tab_setup_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="设置"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
