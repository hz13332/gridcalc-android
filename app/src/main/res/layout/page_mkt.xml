<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 行情输入 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">
            <!-- 顶栏(稿D6替代):‹纯箭头返回自选 + 居中「行情」34sp/800 + 右侧🔍线条图标;
                 margin 0 0 28dp 照稿;无···、无标题副标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/mkt_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:contentDescription="返回自选"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:text="‹"
                    android:textColor="?attr/colorInk"
                    android:textSize="26sp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="行情"
                    android:textColor="?attr/colorInk"
                    android:textSize="34sp"
                    android:textStyle="bold" />
                <ImageButton
                    android:id="@+id/mkt_search"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="搜索品种"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_search"
                    android:tint="?attr/colorInk" />
            </LinearLayout>
            <!-- 品种输入坞(稿mktInputDock):默认隐藏,点顶栏🔍展开并聚焦品种输入框;
                 稿坞内只有 品种输入/查看/星标,无品种名标签 -->
            <LinearLayout
                android:id="@+id/mkt_input_dock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">
                <EditText
                    android:id="@+id/mkt_sym"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:background="@drawable/input_bg"
                    android:hint="品种 BTCUSDT/AAPL"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:textColor="?attr/colorInk"
                    android:textColorHint="?attr/colorFaint"
                    android:textSize="17sp"
                    android:typeface="monospace" />
                <Button
                    android:id="@+id/mkt_go"
                    android:layout_width="84dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/btn_ghost"
                    android:text="查看"
                    android:textColor="?attr/colorInk"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/mkt_fav"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="bottom"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/btn_ghost"
                    android:text="☆"
                    android:textColor="?attr/colorInk"
                    android:textSize="18sp" />
            </LinearLayout>
            <!-- 周期行(稿:周/月/季键高41,行与第二行同栅格) -->
            <LinearLayout
                android:id="@+id/mkt_tf_row"
                android:layout_width="match_parent"
                android:layout_height="41dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/mkt_tf_w"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_ghost"
                    android:text="周线"
                    android:textColor="?attr/colorInk"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/mkt_tf_m"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:text="月线"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/mkt_tf_q"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_ghost"
                    android:text="季线"
                    android:textColor="?attr/colorInk"
                    android:textSize="15sp" />
            </LinearLayout>
            <!-- 第二行(稿):根数输入框常显(宽=周+月) + 右侧▾确认键(宽=季),
                 高41,与周期行同栅格(运行时由syncGrid精确定宽) -->
            <LinearLayout
                android:id="@+id/mkt_row2"
                android:layout_width="match_parent"
                android:layout_height="41dp"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/mkt_kcount"
                    android:layout_width="0dp"
                    android:layout_height="41dp"
                    android:layout_weight="1"
                    android:background="@drawable/input_bg"
                    android:contentDescription="K线数量(15~100)"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="20"
                    android:textColor="?attr/colorInk"
                    android:textColorHint="?attr/colorFaint"
                    android:textSize="16sp"
                    android:typeface="monospace" />
                <Button
                    android:id="@+id/mkt_win"
                    android:layout_width="0dp"
                    android:layout_height="41dp"
                    android:layout_marginLeft="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_ghost"
                    android:text="▾"
                    android:textColor="?attr/colorInk"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 行情图 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:id="@+id/mkt_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="输入品种后查看"
                android:textColor="?attr/colorSub"
                android:textSize="13sp"
                android:visibility="gone" />
            <!-- 稿mkhead:只保留30px现价(mkid品种名小字/mkChg涨跌徽标全树零命中,布局/样式/绘制三处均无) -->
            <TextView
                android:id="@+id/mkt_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="--"
                android:textColor="?attr/colorInk"
                android:textSize="30sp"
                android:textStyle="bold" />
            <!-- 稿D2 srcNote:纯日期区间(从输入卡移此,与稿同位;去掉「·来源(初步·来源)」后缀) -->
            <TextView
                android:id="@+id/mkt_srcnote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp"
                android:text=""
                android:textColor="?attr/colorSub"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/mkt_ohlc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="6dp"
                android:textColor="?attr/colorSub"
                android:textSize="12sp"
                android:typeface="monospace" />
            <cn.gridcalc.gridcalc.MktView
                android:id="@+id/mkt_chart"
                android:layout_width="match_parent"
                android:layout_height="260dp" />
            <!-- v4§7 美元口径说明行(数据源图例下方):汇率/原币/美元报价三态,异步到达后重画 -->
            <TextView
                android:id="@+id/mkt_fx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="?attr/colorSub"
                android:textSize="12sp"
                android:visibility="gone" />
            <TextView
                android:id="@+id/mkt_leg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/colorSub"
                android:textSize="12sp"
                android:typeface="monospace" />
            <!-- 稿TGT:机构目标均价行(Nasdaq聚合,仅美股显示,失败隐藏) -->
            <TextView
                android:id="@+id/mkt_tgt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/colorSub"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
