             状态文案改由上方 mkt_srcrow 承担吗？—— 不，上一行也已隐藏 ⟹ 本屏**不再有任何状态行**。
             ⚠ 这是**有意去掉来源与状态的屏显**，与稿 v2.html:2112-2114 的相反取舍；
               若日后要恢复，两处 GONE 改回 VISIBLE 即可，绑定都还在。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12.4dp"
            android:paddingBottom="12.4dp"
            android:visibility="gone">
            <TextView
                android:id="@+id/mkt_stateline_lead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="7.6dp"
                android:textColor="?attr/colorFaint"
                android:textSize="@dimen/fs_note" />
            <TextView
                android:id="@+id/mkt_stateline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.5"
                android:textColor="?attr/colorFaint"
                android:textSize="@dimen/fs_note" />
        </LinearLayout>

        <!-- mkt_leg 职责收窄为【十字光标行读数】(MktView.kt:310 的 legRow)。
             原来它还兼着状态(前面那串 "· N 根月线已更新"),两个语义挤一个 TextView。
             空时必须 GONE —— 拆开后它会有空值,留空 TextView 就是空行。 -->
        <TextView
            android:id="@+id/mkt_leg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/space_2"
            android:textColor="?attr/colorFaint"
            android:textSize="@dimen/fs_note"
            android:visibility="gone" />

        <!-- t290: 原来这里挂着 4 个无 id 的 O/H/L/C 壳(B-39 修重复块时漏删的残留)。
             它们是 0dp+weight=1, 被同一行里 match_parent 的 mkt_stateline 挤成 0 宽,
             真机上不可见(t287 截图佐证); 真正在用的那套有 id: mkt_o/mkt_h/mkt_l/mkt_c
             (page_mkt.xml 的 344 到 368 行, 初值是两个减号), 由 t106PaintOhlc 经 findViewById 填。
             删掉后本容器只剩 mkt_legdetail / mkt_stateline / mkt_leg, 纵排干净。
             ⚠️ 2026-10-02 更新:上面提到的 mkt_o/mkt_h/mkt_l/mkt_c 已随 OHLC 行整体作废,
             「真正在用的那套」这句话随之作废 —— 现在**没有**哪套在用。 -->
            <!-- t107 ② Vol 归位:与 O/H/L/C 同一水平线的右端(不再挂标题行) -->
        </LinearLayout>


        <!-- ⚠ 2026-10-03 用户裁定：「下面空白区域写支撑线的价位」，
             随后又追一句「能不能有点排版艺术啊」—— 第一版是一行裸文字浮在空白里。
             现在改成**块**：上下各一条发丝线包住，小节标题 + 标签左/数值右两行。

             为什么这么排（三条都对着既有语汇，不是自创）：
             ① 发丝线上下包边 —— 本 App 全局是「无卡片 + 1px 细线分区」（t102 第2步定下的），
                自选屏的行线、设置屏的区块线都是这一套，这里不例外。
             ② 标签左、数值右 —— 直接复用自选屏那张表的「列头 ⟷ 行内右缘对齐」语汇，
                数值一律右缘对齐，位数不同的两行也能竖着对齐。
             ③ 数值用 colorPrimary（决策紫）—— 与图上第一支撑线同色同一个 token，
                「线上的紫」和「下面的价」是同一个决策，不是两件东西。

             字号只用现有两档：标签 fs_note(12) / 数值 fs_title(16)，**没有新增档位** ——
             V1 那一维要求全 App 收敛到 4 档(30/21/16/12)，这里再添一档就破了。
             -->
        <LinearLayout
            android:id="@+id/mkt_supblock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorBorder" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/space_3"
                android:paddingBottom="@dimen/space_2"
                android:text="支撑"
                android:textColor="?attr/colorFaint"
                android:textStyle="bold"
                android:textSize="@dimen/fs_data" />
            <!-- ⚠ 2026-10-03 用户裁定「再大一点，且要粗体」。
                 改前是 fs_note(11.4sp) 常规 —— 四档里最小的一档，当小节标题用明显不对。
                 改成 fs_data(**20sp**)+ textStyle="bold"：
                   · 字号取**现成的上一档**，没有新增第 5 档 —— V1 那一维要求
                     全 App 收敛到 30/20/15.3/11.4 四档，另立一档就破了；
                   · 主题已把 fontFamily 指向 @font/inter（Regular/Medium/SemiBold/Bold 四档齐全），
                     所以 textStyle="bold" 会取到**真的 Inter Bold 字形**，不是合成加粗。
                 ⚠ 若要「粗但没那么重」，把 textStyle 去掉、改 android:fontWeight="600"
                   （SemiBold，同一个 family 里有）；要更重就把 fs_data 换成 fs_hero(28.6sp)。 -->

            <!-- 第一支撑行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="第一支撑"
                    android:textColor="?attr/colorSub"
                    android:textSize="@dimen/fs_note" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1px"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/mkt_sup1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="?attr/colorTeal"
                    android:textSize="@dimen/fs_title" />
            </LinearLayout>

            <!-- 第二支撑行:本屏只有一条支撑时整行 GONE,不摆一个空位 -->
            <LinearLayout
                android:id="@+id/mkt_suprow2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="第二支撑"
                    android:textColor="?attr/colorSub"
                    android:textSize="@dimen/fs_note" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1px"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/mkt_sup2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:textColor="?attr/colorRed"
                    android:textSize="@dimen/fs_title" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_3"
                android:background="?attr/colorBorder" />
        </LinearLayout>

        <!-- ⑫ 底部状态行「· N 根月线已更新」 -->
    </LinearLayout>
</ScrollView>
