<?xml version="1.0" encoding="utf-8"?>
<!--
  t106 行情页外观追稿(B 标杆迁移 · 第 2 台设备 / _shots/2-quote.png)。
    ① 去卡片:两张 card_bg 全删,改留白 + 1px 细线分区
    ② 数量:输入框改无边框右对齐(数值常显右端)。
        ⚠️【F-2c · 2026-10-01】原写的「+ SeekBar 滑杆镜像」**已作废** ——
        用户裁定「不要滑动条了非常的碍事」，滑杆连同 mkt_kbar 节点已整段删除。
        根数入口现在**只有** mkt_kcount 输入框。这行注释留着是为了提醒：
        **别再把滑杆加回来**，也别照它去同步什么「镜像」。
     ③ OHLC / ⑤ Vol:**已删除**(2026-10-02 用户裁定「这两个不要」),见下方墓碑
    ④ 涨跌额:独立成行,涨绿跌红
    ⑥ 交易所/时点:「NASDAQ · 收盘」/「09:31:04 GMT-4」
    ⑩ 「美元口径(该品种以美元报价)」整行删除(稿里没有,是说明性文字)
    ⑬ 机构目标均价/步长阈值保留,并排进价格块,不单独占大块
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/space_4"
        android:paddingRight="@dimen/space_4"
        android:paddingTop="@dimen/space_3"
        android:paddingBottom="@dimen/space_8">

    <!-- t385 统一 16dp: 改前**两层**嵌套容器各带一份 space_4 ⟹ 标题/数量/现价/
         图表/源状态行全是 32dp，OHLC/StateLine/品种块再各加 16 ⟹ 48dp，
         而稿(L523/L543/L554/L572/L578/L582)是**每个块自带 16px、页面根零内边距**。
         现在只留外层那份当页面基准，本层与下面几处自带的横向 padding 都已删。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/space_3"
        android:paddingBottom="0dp">
        <!-- ⚠⚠ 2026-10-03 用户裁定删掉源状态行与状态行之后，这层 paddingBottom 成了「没人认领的空白」。
             原值 @dimen/space_8(30.5dp)：**这一层的闭合在下面 L647，紧接着就是 mkt_supblock**，
             于是 30.5dp 底距 + mkt_supblock 自己的 marginTop(11.4dp) = 41.9dp。
             真机实测: mkt_stept 底 567.6dp → mkt_supblock 顶 609.5dp = **41.9dp，一字不差**。
             那 30.5dp 原本是给「· N 根月线已更新」预留的；那行已被裁定删除，底距就没人认领了。
             ⚠ 外层容器(上面 L26-31)仍保留自己的 space_8，**页面底部留白不受影响**；
               去掉的只是夹在内容中间的这一份，两处别一起改。 -->

        <!-- ============ 顶栏(无卡片) ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <!-- t201 ⑧:原本这里有个「‹」返回按钮(mkt_back), 已按稿删掉 ——
                 稿 L522 是 <AppBar title="行情"/>, 里面【只有标题】, 没有任何左右控件。
                 系统返回键走 OnBackPressedDispatcher(MainActivity), 未动。
                 ⚠ 搜索入口(mkt_searchtx/mkt_search)【保留】: 稿 L527/L529 本来就有, 别再删。 -->
            <!-- 顶栏 = 稿 L522 <AppBar title="行情"/>, 【只有标题】, 就是下面这个 mkt_title。
                 稿 L523 把搜索块放在 AppBar【下面】的独立一块(自带底线), App 现在也是那样:
                 紧接其下那个带 mkt_search_block 底的描边盒承载 mkt_symname + mkt_searchtx。
                 ⚠ 本段原来写的是 t108/t201 的说法: 顶栏 = 品种名 + 右侧『搜索』入口,
                 且说搜索块还并进顶栏行、本轮不挪。t252 已经把它挪进下面的描边盒了。 -->
            <TextView
                android:id="@+id/mkt_title"
                android:letterSpacing="-0.01"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="start"
                android:maxLines="1"
                android:text="行情"
                android:textColor="?attr/colorInk"
                android:textSize="@dimen/fs_title"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- t252 稿 L522: 顶栏到此为止, 【只有标题】。
             原来并在这一行的 mkt_searchtx / mkt_search 已按稿 L523-527 移进下面的描边盒。 -->

        <!-- t252 稿 L523: 独立块, 自带底线
             ⚠ 2026-10-02 用户裁定「不需要这个」：整块**隐藏**。
               现行稿的 ScreenQuote 顶部（v2.html:2061-2062）逐字只有两样：
                 <AppBar title="行情"/>
                 <div padding:'11px 16px' borderBottom>{<Seg 周/月/季>} {数量 label+input}</div>
               **没有品种搜索框**——稿的品种是「自选 → 点行」带进来的，
               换品种也走自选那一跳（稿的 quote 页同样没有搜索入口）。
               本块 = 描边盒(品种名 + 「搜索」) + 下面的候选列表触发，是 App 自有。
               保留视图与 mkt_searchtx / mkt_symname / mkt_input_dock 的全部 findViewById
               （只改 visibility，Kotlin 侧一行不动），日后要恢复只删这一行 gone。
               ⚠ 品种代码因此从屏上消失 → 已挪到价格块右上角 mkt_venue（照稿 `{代码} · 时段`），
                 否则打开行情页不知道自己看的是哪个品种。 -->
        <LinearLayout
            android:id="@+id/mkt_search_block"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_3"
            android:paddingBottom="@dimen/space_2"
            android:background="@drawable/mkt_search_block">
            <!-- t252 稿 L525: 1px 描边 + radius 8 的盒子 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/space_3"
                android:background="@drawable/mkt_search_box">
                <!-- 稿 L526: 品种名 T.title + 600 + ink -->
                <TextView
                    android:id="@+id/mkt_symname"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="1"
                    android:text="—"
                    android:textColor="?attr/colorInk"
                    android:textSize="@dimen/fs_title"
                    android:textStyle="bold" />
                <ImageButton
                    android:id="@+id/mkt_search"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
                <!-- 稿 L527: 「搜索/收起」T.note + ink3, flexShrink 0 -->
                <TextView
                    android:id="@+id/mkt_searchtx"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="搜索"
                    android:textColor="?attr/colorFaint"
                    android:textSize="@dimen/fs_note" />
            </LinearLayout>
        </LinearLayout>

        <!-- #53 稿 L529-541: 展开后是**竖向候选列表**, 不是一行输入坞。
             稿 L530 那个盒子: marginTop 10 / border 1px / borderRadius 8 / overflow hidden
             ⟹ 由本容器承担(描边盒复用 mkt_search_box, 与稿 L525 是同一个盒子)。
             稿 L534-538 每一行: padding 13 / 末行不画底线 / flex / gap 10 / center
             ⟹ 行内容 = 代码(T.title + 600 + ink, 不伸缩) + 名称(T.note + ink2 + 省略号),
             由 MktPanel.showSug 按**真实联想**结果铺进去(稿 L531-533 那三条是演示数据, 不写死)。
             ⚠ mkt_input_dock 由 horizontal 改 vertical: 三个控件的 id 与类型一律不动,
               原样搬进下面那个无 id 的横向行容器, findViewById 全部照旧。 -->
        <LinearLayout
            android:id="@+id/mkt_input_dock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9.5dp"
            android:background="@drawable/mkt_search_box"
            android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingLeft="12.4dp"
                android:paddingRight="12.4dp">
                    <EditText
                        android:id="@+id/mkt_sym"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:gravity="right|center_vertical"
                        android:hint="品种 BTCUSDT/AAPL"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions"
                        android:imeOptions="actionDone"
                        android:singleLine="true"
                        android:textColor="?attr/colorInk"
                        android:textColorHint="?attr/colorFaint"
                        android:textSize="@dimen/fs_title"
                        android:typeface="monospace" />
                    <Button
                        android:id="@+id/mkt_go"
                        android:layout_width="68.7dp"
                        android:layout_height="42dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="@dimen/space_2"
                        android:background="?attr/colorPrimary"
                        android:text="查看"
                        android:textColor="?attr/colorOnPrimary"
                        android:textSize="@dimen/fs_note" />
                    <Button
                        android:id="@+id/mkt_fav"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="@dimen/space_1"
                        android:background="@android:color/transparent"
                        android:text="☆"
                        android:textColor="?attr/colorInk"
                        android:textSize="@dimen/fs_title" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/space_2"
            android:background="?attr/colorBorder" />

        <!-- ⚠ 2026-10-02 照稿：周期与数量**并成一行**。
             稿 v2.html:2062-2064 逐字：
               <div style={{padding:'11px 16px',borderBottom:'1px solid <line>',
                            display:'flex',alignItems:'center',gap:16}}>
                 <Seg [周线|月线|季线] sm/>
                 <div style={{flex:1}}> 数量 label + 描边 input </div>
               </div>
             改前这里是**两行**（周期一行、数量独占一行），比稿多占一整行，
             屏上被用户看见的是「多出来的字/多出来的行」。
             ⟹ 本容器承接 display:flex；周期行按内容收窄(flexShrink:0)，
               数量块吃掉余量(flex:1)并把值推到行右端。 -->
        <LinearLayout
            android:id="@+id/mkt_period_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:paddingTop="@dimen/space_3"
            android:paddingBottom="@dimen/space_3">

        <!-- 周期行(周/月/季)。稿 L256 逐字: 稿那个 Seg 是 **inline-flex** ⟹ 整盒
             按内容收窄(flexShrink:0), 不是盒里的段 —— 描边 seg_frame 必须跟着一起收窄。
             t396 只把三个 Button 改成 wrap_content, 容器还留着 match_parent,
             于是真机上描边框横贯整行、紫色选中段只占左侧一小截。
             父容器是 vertical, 故同时写 layout_gravity=start, 不靠默认对齐。
             旁证: page_settings.xml 里同一个 Seg 容器本来就是 wrap_content。 -->
        <LinearLayout
            android:id="@+id/mkt_tf_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:orientation="horizontal"
            android:paddingStart="1dp"
            android:paddingEnd="1dp"
            android:background="@drawable/seg_frame"
            android:clipToOutline="true">
            <!-- ⚠ 2026-10-03 这两个 padding 是**补边框占位**，不是排版需要。
                 Playwright 实测稿（.tmp/draftseg.py，从「周线」叶子往上逐层量）:
                     单格   padding 7px 11px · fontSize 12px · w=46
                     容器   display:flex · border:1px solid · x=16 · w=140
                 按口径 ×0.9539 折 dp:  单格 43.9 / 容器 133.6
                 App 实测:                     单格 43.6 / 容器 130.9
                 ⟹ **单格只差 0.3dp，已经对上**；总宽差 2.7dp 全部来自边框算法:
                     稿的 border:1px 长在盒子**外** → 计入布局尺寸(140 = 3×46 + 2)
                     App 的 seg_frame 是 background 描边 → 画在盒子**内** → 不计入(130.9 = 3×43.6)
                 左右各补 1dp 让容器总宽与稿一致(130.9 + 2 = 132.9 ≈ 133.6)。
                 ⚠ 别把这 1dp 当内边距删掉 —— 它就是那圈 1px 描边在稿里的占位。 -->
            <Button
                android:id="@+id/mkt_tf_w"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:text="周线"
                android:textColor="?attr/colorSub"
                android:textSize="@dimen/fs_note"
                android:paddingStart="10.5dp"
                android:paddingEnd="10.5dp"
                android:paddingTop="6.7dp"
                android:paddingBottom="6.7dp"
                android:maxLines="1"
                android:minWidth="0dp" />
            <Button
                android:id="@+id/mkt_tf_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:text="月线"
                android:textColor="?attr/colorInk"
                android:textSize="@dimen/fs_note"
                android:paddingStart="10.5dp"
                android:paddingEnd="10.5dp"
                android:paddingTop="6.7dp"
                android:paddingBottom="6.7dp"
                android:maxLines="1"
                android:minWidth="0dp" />
            <Button
                android:id="@+id/mkt_tf_q"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:text="季线"
                android:textColor="?attr/colorSub"
                android:textSize="@dimen/fs_note"
                android:paddingStart="10.5dp"
                android:paddingEnd="10.5dp"
                android:paddingTop="6.7dp"
                android:paddingBottom="6.7dp"
                android:maxLines="1"
                android:minWidth="0dp" />
        </LinearLayout>

        <!-- #55 + #56 数量块。
             ⚠ 2026-10-02：orientation 由 vertical 改 **horizontal**、宽度 0dp + weight 1，
             于是它与周期行并排成稿的一行（周期在左、数量块吃余量把值推到右端）。
             改前它是 match_parent/vertical，周期与数量被拆成上下两行。 -->
        <LinearLayout
            android:id="@+id/mkt_row2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:layout_marginStart="22.9dp">
            <!-- 稿 L2065-2070: 标签 + 描边输入框，同一行两端对齐。
                 值盒另留 36dp 高(可点进去改)，稿那个 input 由行高决定 ⟹ App 自有取舍。
                 ⚠ 本框宽度必须留在 wrap_content: 运行期 syncGrid 曾按栅格写死宽度, 已删除 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="数量"
                    android:textColor="?attr/colorFaint"
                    android:textSize="@dimen/fs_note" />
                <!-- ⚠ 2026-10-03 用户指出的间距问题，已与上面 mkt_row2 的 marginStart 一起改：
                     原状：周期段→数量 15.2dp， 数量→输入框 11.4dp
                           —— 两段只差 1.33 倍，「数量+输入框」这个**标签值对**看不出来，
                              读起来像四个并列的东西挤在一行。
                     改成：周期段→数量 **22.9dp**(space_6)， 数量→输入框 **7.6dp**(space_2)
                           —— 间距拉开 3 倍，左边「周期段」与右边「数量[20]」才分成两组。
                     ⚠ 这**偏离稿**：稿 v2.html:2063 整行是 gap:16 单一间距，
                       没有「组内紧、组间松」这层层级。属产品裁定。
                     ⚠ 两处的 marginStart 都是**写死数字**不是 @dimen，
                       要调就 310 行(mkt_row2) 与下面 EditText 这行**一起改**，别只动一头。
                     ⚠ 注释别放进未闭合的标签里 —— 那会让 XML 解析失败。 -->
                <EditText
                    android:id="@+id/mkt_kcount"
                    android:layout_width="wrap_content"
                    android:layout_height="34.3dp"
                    android:layout_marginStart="7.6dp"
                    android:minWidth="66.8dp"
                    android:background="@drawable/mkt_count_box"
                    android:contentDescription="K线数量(15~100)"
                    android:fontFeatureSettings="tnum"
                    android:gravity="right|center_vertical"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    android:singleLine="true"
                    android:paddingLeft="5.7dp"
                    android:paddingRight="5.7dp"
                    android:text="20"
                    android:textColor="?attr/colorInk"
                    android:textColorHint="?attr/colorFaint"
                    android:textSize="@dimen/fs_title" />

                <!-- ⚠ 2026-10-03 用户第三次说「还是这么长」+「这一栏都很长」，
                     这次问清了：**嫌的是整行**，不是某一段。
                     ⟹ mkt_period_row 本身是 match_parent(铺满 361dp)，无论怎么缩内部元素，
                        行的**右缘永远顶到屏幕右边**，空档只会越变越大 —— 那是「变长」不是「变短」。
                     ⟹ 真正能让这一栏变短的只有一个办法：**内容收短、右侧留白**。
                        做法：「数量」标签由 weight=1 改成 wrap_content（不再撑开），
                        输入框后补一个 0dp/weight=1 的空 View 把余量吃掉。

                     ⚠ 这次与稿不一致，**且我上次撤过一次、又撤错了**：
                        稿 v2.html:2066 是 justifyContent:'space-between'（输入框顶行右端），
                        上一轮我照稿还原后你说「改前也不一致啊，我都说了长了」——
                        也就是说**这条抱怨早于我任何一次改动，原样(space-between)就不满足**。
                     ⚠ 代价要记清:改完之后这一行与稿不再逐像素对齐（输入框右缘 232dp vs 稿 377.7dp）。
                        若日后要回到照稿：删掉下面这个空 View、给「数量」标签加回
                        layout_width=0dp + layout_weight=1，一步还原。
                        要核稿的几何时重跑 .tmp/draftrow.py，别比截图。 -->
                <!-- ⚠⚠ 2026-10-03 **用户裁定恢复确认键 + 二次确认**。
                     原话：「为什么没有确认键，调好的周期怎么保存，一退出去数据又没了」
                          →「要确认键继续二次确认」。
                     ⟹ t107 把 ▾ 下拉整条移除后，**屏上再无任何入口能调到 saveWin()**，
                       而 onLeave() 又在主动丢弃 —— 两头一夹必丢。
                     ⟹ 现在「确认」是**可见按钮**，紧跟在 mkt_kcount 后面（本行内）。
                       点它 → MktPanel.toggleWinPop() 弹**二次确认对话框** → 确定才 saveWin()。
                     ⚠ 「▾下拉」那个形态**没有**恢复：它原本弹 15~100 点选列表，
                       那是滑杆时代的产物（滑杆已按裁定删除、输入框取代）。保留一个
                       只装「确认」的下拉没意义，故直接用按钮。
                     ⚠ 这按钮先前挂在**外层竖排**容器里，被数量行挤成 0 高、静默消失；
                       现已搬进本行，教训见下面那段墓碑。
                     ⚠ 若日后恢复 ▾ 形态：点击监听改回 toggleWinPop，
                       且 pop 里的「确认」项要一并接上二次确认，两处成对。 -->
                <Button
                    android:id="@+id/mkt_win"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_2"
                    android:minWidth="0dp"
                    android:background="@drawable/mkt_count_box"
