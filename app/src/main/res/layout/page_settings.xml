<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 外观 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="外观"
                android:textColor="?attr/colorInk"
                android:textSize="16sp"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/theme_follow"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:text="跟随系统"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/theme_light"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_ghost"
                    android:text="浅色"
                    android:textColor="?attr/colorInk"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/theme_dark"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_ghost"
                    android:text="深色"
                    android:textColor="?attr/colorInk"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 费率 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="费率"
                android:textColor="?attr/colorInk"
                android:textSize="16sp"
                android:textStyle="bold" />
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginRight="6dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="手续费率 %"
                        android:textColor="?attr/colorSub"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />
                    <EditText
                        android:id="@+id/in_fee"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/input_bg"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="0.05"
                        android:textColor="?attr/colorInk"
                        android:textColorHint="?attr/colorFaint"
                        android:textSize="17sp"
                        android:typeface="monospace" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginLeft="6dp"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="5dp"
                        android:text="维持保证金率 %"
                        android:textColor="?attr/colorSub"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />
                    <EditText
                        android:id="@+id/in_mmr"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/input_bg"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="1"
                        android:textColor="?attr/colorInk"
                        android:textColorHint="?attr/colorFaint"
                        android:textSize="17sp"
                        android:typeface="monospace" />
                </LinearLayout>
            </GridLayout>
        </LinearLayout>

        <!-- 关于 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="关于"
                android:textColor="?attr/colorInk"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="网格交易收益计算器 v2.0.4\n等比网格 · 路径法爆仓价 · 离线运行"
                android:textColor="?attr/colorSub"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
