<?xml version="1.0" encoding="utf-8"?>
<!-- ══════════════════════════════════════════════════════════════════════════════
     设置屏 · 方向 B「分层卡片」代码轮（2026-10-16 t50）
     ──────────────────────────────────────────────────────────────────────────────
     规格来源：`design/四屏视觉改版/交接_方向B.md` §2.4（组件 11 类）+ §5.3-M7/M8/M10
               + `方向-B/四屏-设置页.html`（逐控件对照）+ `方向-B/设计语言.md` §3
     token 来源：t49 已落地的 `values/themes.xml`（26 个 attr）+ `values/dimens.xml`
               （4 档字 + fs_micro + 7 档间距 + 4 级抬升）——**本文件只消费，不新增任何值**。

     本轮**只动视觉与排布**，三处结构改动逐条记：
      ① 分组语汇：v1 的「弱标题 + 强内容行 + 通栏发丝」→ 方向 B 的「**分组 = 一张卡**」
         （§2.4-3.2）：卡面 colorCard + r12（card_bg）+ elev_1（浅 2dp / 深 0）+ clipToOutline；
         卡内行分隔 = 1dp colorBorder（§2.4-3.3「行分隔 = border-bottom，末行不画」）。
      ② S1 收口机制沿用（两组分贴上下 + 中间有界呼吸区）：Android 侧的
         `justify-content: space-between` = **外层 match_parent + 中间 Space(weight=1)**
         （fillViewport 保证内容不足时也铺满视口，weight 才有的可分）。
      ③ 主题三段 = **轨道药丸 + 抬起的选中药丸**（§2.4-3.6）：轨道 seg_frame
         （bg-surface-2 + r999 + 3dp 内边距），段内边距 5dp/12dp，选中底 = seg_sel
         （colorSurfaceRaised，**不再占主色实底**），抬升由宿主 View 消费 elev_1
         （drawable 画不了阴影）⟹ 由 paintThemeSeg() 运行期设 `btn.elevation`。

     ⚠ U-9（交接 §5.1-⑥「同一件事两个主人」）**本轮关闭**：
       三个 Button 的 `android:textColor` / `android:textStyle` **已删**（改前写死
       colorOnPrimary / colorSub / bold，运行期 paintThemeSeg() 又覆写一遍）。
       此后「背景 + 字色 + 字重 + 抬升」四件**只有 paintThemeSeg() 一处主人**。

     ⚠ 未改（用户裁定 / 既有条件）：
       · 开关关态的按压与常态同值（用户裁定，switch_track.xml 的关态 item 不带 pressed 分支）；
       · 触摸目标：本屏 9 控件 5 项 <48dp（交接 §6.2），**不为凑 48 缩内容** ——
         命中区与真实点击区对齐即可（本轮行高按 §2.4-3.3 的 58/16 落地，已比 v1 更高）。
       · 顶部 AppBar 与「费率」空壳标题的删除（2026-10-08 用户裁定）**保持**。

     ⚠ 所有原有 id 与控件类型保持不变（MainActivity 的 findViewById 绑定不许断）：
       theme_follow / theme_light / theme_dark（Button，paintThemeSeg 强转 Button）、
       set_auto_sw（Switch）、about_version / about_disclaimer（TextView）。
     ══════════════════════════════════════════════════════════════════════════════ -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none"
    android:clipToPadding="false">

    <!-- 外层 match_parent + 中间 Space(weight=1) = 方向 B 设置屏的 space-between（见文件头 ②）。
         页面左右/下内边距 = space_4（16dp）= 原型 `.gc-set` 的 padding（0 / sp-4 / sp-4）。
         ⚠ 本文件所有注释里**不写 CSS 变量名**（形如「两个连字符 + sp-4」那种写法）——
           XML 注释体里不允许出现连续两个连字符，写了整份资源解析失败（本文件第一版踩过，
           与 drawable/seg_box.xml 文件头登记的同一个坑）。变量一律写「sp-N 变量」这种说法。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="@dimen/space_4"
        android:paddingRight="@dimen/space_4"
        android:paddingBottom="@dimen/space_4">

        <!-- ═══════════════════ 外观组 ═══════════════════ -->

        <!-- 分组小标题（§2.4-3.3 / 原型 `.gc-cap`）：卡片**外**，12sp / 600 / faint + 宽字距。
             marginTop = sp-5(20) / marginBottom = sp-2(8)；左右 padding = sp-1(4)，
             与原型 `.gc-cap` 的 margin（sp-5 / 0 / sp-2）与 padding（0 / sp-1）逐值同源。
             ⚠ 改前用 sec_top/sec_bot（21/1.9dp，v1 稿的单列特例）—— t49 已把这两个名字
               并入 space_5/space_1 并标「新代码不许再用」，本轮起**不再引用旧名**。 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginBottom="@dimen/space_2"
            android:paddingLeft="@dimen/space_1"
            android:paddingRight="@dimen/space_1"
            android:letterSpacing="0.04"
            android:text="外观"
            android:textColor="?attr/colorFaint"
            android:textSize="@dimen/fs_note"
            android:textStyle="bold" />

        <!-- 卡片（§2.4-3.2）：分组 = 一张卡。
             card_bg = colorCard + r12（t49 落；**无描边** —— 1dp stroke 已由 2026-10-16 t1「方案 A」删除）；抬升 = elev_1（浅 2dp / 深 0）。
             clipToOutline：让卡内两行随 r12 圆角裁切（原型靠分片圆角 + 同一配方投影实现）。
             ⚠ 口径差已收口（2026-10-16 t1「方案 A」，用户拍板）：原型卡片无 1dp 描边（theme.css 的卡 = 面 + 阴影），
               App 侧的 r12 卡面 drawable（card_bg）**已无描边**（其 1dp stroke 即 t1 所删），
               ⟹ 本页卡片与原型一致；原注释「要彻底去描边属 drawable 层改动」描述的缺口已在 t1 关闭。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:elevation="@dimen/elev_1"
            android:clipToOutline="true">

            <!-- 主题行（§2.4-3.3：行 ≈58px / 内边距 16；本行被分段器撑到 ≈65，与原型同源） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="58dp"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="主题"
                    android:textColor="?attr/colorInk"
                    android:textSize="@dimen/fs_title"
                    android:textStyle="bold" />

                <!-- 原型 `.gc-row` 的 justify-content: space-between ⟹ Android 用 weight=1 的 Space 顶右 -->
                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- 分段器轨道（§2.4-3.6）：bg-surface-2 + r999 + **3dp 内边距**（语言层的组件几何，
                     不是间距 token；吸到 4dp 会改变轨道与药丸的比例）。
                     ⚠ 这里**不再 clipToOutline**：方向 B 的段自己就是药丸（r999）、且段内缩 3dp，
                       不需要靠宿主裁剪成形；保留裁剪会把选中药丸的 elev_1 阴影一起裁掉。 -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/seg_frame"
                    android:padding="3dp">

                    <!-- ⚠ 三个 Button 的静态 textColor / textStyle 已按 U-9 删除（见文件头）；
                         常态底 seg_sel / seg_unsel 保留为**初值**，运行期由 paintThemeSeg() 接管。
                         段内边距 5dp / 12dp = 语言层 §2.4-3.6 的 padding 5px / sp-3 变量。 -->
                    <Button
                        android:id="@+id/theme_follow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingLeft="@dimen/space_3"
                        android:paddingRight="@dimen/space_3"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:background="@drawable/seg_sel"
                        android:text="跟随系统"
                        android:textSize="@dimen/fs_note" />
                    <Button
                        android:id="@+id/theme_light"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingLeft="@dimen/space_3"
                        android:paddingRight="@dimen/space_3"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:background="@drawable/seg_unsel"
                        android:text="浅色"
                        android:textSize="@dimen/fs_note" />
                    <Button
                        android:id="@+id/theme_dark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingLeft="@dimen/space_3"
                        android:paddingRight="@dimen/space_3"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:background="@drawable/seg_unsel"
                        android:text="深色"
                        android:textSize="@dimen/fs_note" />
                </LinearLayout>
            </LinearLayout>

            <!-- 行分隔（§2.4-3.3）：卡内 1dp colorBorder；末行不画 ⟹ 本行之后不再有线 -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorBorder" />

            <!-- 开关行：标签 weight=1（= 原型 `.gc-row` 的 space-between），控件靠右。
                 ⚠ id = set_auto_sw：MainActivity.kt:3117 起 findViewById + t211PaintSwitch 染两态。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="58dp"
                android:padding="@dimen/space_4">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="启动时刷新一次"
                    android:textColor="?attr/colorInk"
                    android:textSize="@dimen/fs_title"
                    android:textStyle="bold" />

                <!-- §2.4-3.7 / §5.3-M10：**44×26 轨道**（改前 42×24.8 —— v1 稿的换算值）。
                     色与描边（开 accentFill / 开+按压 accentPressed / 关 trackOff，两态都有描边）
                     由 t49 的 switch_track.xml 四态 selector 自带；
                     滑块两态由 t211PaintSwitch() 的 thumbTintList 染（on-accent / thumb-off）。
                     thumb 直径与位移由平台按轨道尺寸算（Android 不暴露该几何）⟹ 装机实测值见交付说明。 -->
                <Switch
                    android:id="@+id/set_auto_sw"
                    android:layout_width="44dp"
                    android:layout_height="26dp"
                    android:contentDescription="启动时刷新一次"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 中间有界呼吸区（S1）：weight=1 把「关于」组压到屏底，空白收成两段之间一处；
             不做任何装饰（种子 §1-3「层次不靠装饰」）。 -->
        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ═══════════════════ 关于组 ═══════════════════ -->

        <!-- 与「外观」同规格（原型两个 .gc-cap 逐字同形） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_5"
            android:layout_marginBottom="@dimen/space_2"
            android:paddingLeft="@dimen/space_1"
            android:paddingRight="@dimen/space_1"
            android:letterSpacing="0.04"
            android:text="关于"
            android:textColor="?attr/colorFaint"
            android:textSize="@dimen/fs_note"
            android:textStyle="bold" />

        <!-- 关于卡 = 三段拼一张（§2.4-3.2 / 原型 .gc-about__ver / __sub / __note）：
             三段共用同一配方（面 + r12 + elev_1），**无缝**；段间不画线（原型也不画）。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:elevation="@dimen/elev_1"
            android:clipToOutline="true">

            <!-- t117 ③ 层级：**应用名在主位**（fs_title + ink + 600），「等比网格」是小字副标。
                 ⚠ 版本号不写死：运行期从 PackageInfo 取 versionName（MainActivity.kt:2706 附近）。
                 内边距 = 原型 `.gc-about__ver` 的 padding（sp-4 / sp-4 / 0）。 -->
            <TextView
                android:id="@+id/about_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/space_4"
                android:paddingRight="@dimen/space_4"
                android:paddingTop="@dimen/space_4"
                android:text="网格交易收益计算器"
                android:textColor="?attr/colorInk"
                android:textSize="@dimen/fs_title"
                android:textStyle="bold" />

            <!-- 原型 `.gc-about__sub` 的 padding（sp-1 / sp-4 / 0），字色 ink-sub -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/space_4"
                android:paddingRight="@dimen/space_4"
                android:paddingTop="@dimen/space_1"
                android:lineSpacingMultiplier="1.45"
                android:text="等比网格"
                android:textColor="?attr/colorSub"
                android:textSize="@dimen/fs_note" />

            <!-- 免责声明 —— 稿 L798 逐字，不多不少。
                 内边距 = 原型 `.gc-about__note` 的 padding（sp-3 / sp-4 / sp-4）；
                 行高 1.45 = §2.2 的 fs-note 档 lh（用 lineSpacingMultiplier 而非 android:lineHeight：
                 后者是 API 28+，本仓 minSdk = 26，与 FavPanel.kt:447-450 的处置同一条）。 -->
            <TextView
                android:id="@+id/about_disclaimer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/space_4"
                android:paddingRight="@dimen/space_4"
                android:paddingTop="@dimen/space_3"
                android:paddingBottom="@dimen/space_4"
                android:lineSpacingMultiplier="1.45"
                android:text="结果由输入参数推导，不构成投资建议。"
                android:textColor="?attr/colorFaint"
                android:textSize="@dimen/fs_note" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
