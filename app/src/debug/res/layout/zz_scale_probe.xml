<?xml version="1.0" encoding="utf-8"?>
<!--
  口径探针（debug 变体专用，正式包不含此布局）。

  作用：量出 Paparazzi 这次渲染**实际的 dp → px 比例**。
  为什么需要：Paparazzi 1.3.4 的渲染密度由 `Density` 枚举档决定（只认标准档），
  而本机真机是 1080×2400 @440dpi = 2.75×。两者一旦不一致，Paparazzi 的图
  就**不能**与真机截图逐像素比（只能看相对变化）。

  量法：左侧一块 100dp×100dp 的纯红方块 ⟹ 图里红色像素宽度 ÷ 100 = 实际比例。
  跑法：./gradlew recordPaparazziDebug  ⟹ python toolchain/paparazzi/scale_probe.py
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF">

    <View
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="#FFFF0000" />
</FrameLayout>
